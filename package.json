{
  "name": "uc-entrepreneurship-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check && fallow",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "a11y": "node scripts/a11y/run.mjs",
    "a11y:axe": "node scripts/a11y/axe.mjs",
    "a11y:pa11y": "pa11y-ci --config .pa11yci.json",
    "crawl": "node scripts/crawl/run.ts",
    "crawl:news": "node scripts/crawl/news/run.ts",
    "build-data": "node scripts/crawl/build-data.ts",
    "build-news-data": "node scripts/crawl/news/build-data.ts",
    "refresh-data": "vp run crawl && vp run build-data",
    "refresh-news": "vp run crawl:news && vp run build-news-data"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "fallow": "3.18.0",
    "jsdom": "30.0.1",
    "pa11y-ci": "^4.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "packageManager": "pnpm@10.33.3"
}
