# Cloudflare Workers static-asset headers. GitHub Pages ignores this file, so
# the CSP is also injected as a <meta> tag at build time (vite.config.ts);
# frame-ancestors is the one directive a meta CSP can't carry, hence the header.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
